SECRET_KEY=replace_with_a_secure_random_value

DATABASE_URL=sqlite:///alrayyan.db

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
EMBEDDING_BATCH_SIZE=20
# Optional: use only to bootstrap the very first administrator, then remove these values.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional SMTP settings required for password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=1
